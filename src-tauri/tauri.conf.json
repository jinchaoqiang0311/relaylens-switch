{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RelayLens Switch",
  "mainBinaryName": "relaylens-switch",
  "version": "../package.json",
  "identifier": "com.relaylens.switch",
  "build": {
    "beforeDevCommand": "bun run dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RelayLens Switch",
        "width": 760,
        "height": 680,
        "minWidth": 720,
        "minHeight": 660,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: https://data.relaylens.local; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; frame-src 'none'; base-uri 'none'",
      "capabilities": ["default"]
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["relaylens"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IHJlbGF5bGVucyBwbGFjZWhvbGRlciBwdWJrZXkgLSByZXBsYWNlIHdpdGggeW91ciBvd24gbWluaXNpZ24gcHVibGljIGtleQpBQUFB",
      "endpoints": [
        "https://updates.relaylens.invalid/switch/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "macOS": {},
    "resources": {
      "../LICENSE": "LICENSE",
      "../NOTICE": "NOTICE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../THIRD_PARTY_LICENSES.txt": "THIRD_PARTY_LICENSES.txt",
      "../src/assets/tool-logos/LOBEHUB-ICONS-LICENSE": "LOBEHUB-ICONS-LICENSE"
    },
    "icon": [
      "icons/128x128@2x.png",
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
